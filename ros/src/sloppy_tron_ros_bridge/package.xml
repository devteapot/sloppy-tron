  <version>0.0.0</version>
  <description>ROS 2 bridge nodes for the SloppyTron SLOP body provider.</description>
  <maintainer email="sloppy@example.invalid">SloppyTron maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
